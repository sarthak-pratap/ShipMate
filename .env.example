# Copy to .env and fill in. The app runs WITHOUT any of these (in-memory store,
# prompt-mode disabled) — set them to unlock persistence and Mode 1.

# --- local Postgres (from docker-compose) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shipmate
DB_USER=shipmate
DB_PASS=shipmate

# --- local Valkey (from docker-compose) ---
CACHE_HOST=localhost
CACHE_PORT=6379

# --- Azure AI Foundry (Azure OpenAI) for prompt mode (Mode 1) ---
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=your-gpt-deployment-name
AZURE_OPENAI_API_VERSION=2024-06-01
